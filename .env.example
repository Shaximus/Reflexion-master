# ============================================================================
# REFLEXION SHIELD — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# Only TWEETAPI_KEY and DEEPSEEK_API_KEY are required for basic operation.
# ============================================================================

# ---------------------------------------------------------------------------
# TweetAPI Configuration (REQUIRED)
# Get your API key from https://www.tweetapi.com/dashboard
# ---------------------------------------------------------------------------
TWEETAPI_KEY=your_tweetapi_key_here

# ---------------------------------------------------------------------------
# Redis (REQUIRED for dashboard)
# Used by dashboard.py for swarm state and coordination
# ---------------------------------------------------------------------------
REDIS_PASSWORD=your_redis_password_here

# ---------------------------------------------------------------------------
# MCP Grid Path (optional — drs_shield.py)
# Path to the MCP surveillance grid JSON used by Shield DRS.
# Defaults to ../../local-inference/mcp_surveillance_grid.json relative to src/
# ---------------------------------------------------------------------------
# MCP_GRID_PATH=/path/to/mcp_surveillance_grid.json

# ---------------------------------------------------------------------------
# AI API Keys for bot intelligence
# DeepSeek is primary (cheap and effective). Others are optional.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Gemini (used by cost_optimized_llm_cascade.py)
# GEMINI_API_KEY=your_gemini_key_here

# OpenAI / GPT (optional fallback in cascade and reflexion_bot)
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4

# Grok / xAI (optional — cascade checks XAI_API_KEY, GROK_API_KEY, GROK_LLM_API_KEY)
# XAI_API_KEY=your_xai_key_here
# GROK_API_KEY=your_grok_key_here
# GROK_LLM_API_KEY=your_grok_llm_key_here

# Anthropic / Claude (optional fallback in cascade)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# CLAUDE_API_KEY=your_claude_key_here

# ---------------------------------------------------------------------------
# Soul Tokens (optional — defaults shown)
# ---------------------------------------------------------------------------
# SOUL_TOKENS_DIR=./tokens/
# BANNED_SOULS_FILE=./engagement/banned_souls.json

# ---------------------------------------------------------------------------
# Proxy Configuration (optional)
# ---------------------------------------------------------------------------
# PROXY_LIST=socks5://user:pass@host:port,socks5://user:pass@host2:port
# CASCADE_PROXY=socks5://user:pass@host:port
# PROXY_SYSTEM=webshare
# WEBSHARE_API_KEY=your_webshare_key_here
# IPROYAL_FILE=iproyal.txt

# ---------------------------------------------------------------------------
# Captcha Solvers (optional — used by reflexion_bot_ultimate_merged.py)
# ---------------------------------------------------------------------------
# CAPSOLVER_API_KEY=your_capsolver_key_here
# TWOCAPTCHA_API_KEY=your_2captcha_key_here
# ANTICAPTCHA_API_KEY=your_anticaptcha_key_here

# ---------------------------------------------------------------------------
# SMS / Phone Verification (optional — used by reflexion_bot)
# ---------------------------------------------------------------------------
# SMS_ACTIVATE_API_KEY=your_sms_activate_key_here
# FIVESIM_API_KEY=your_fivesim_key_here
# SMSPVA_API_KEY=your_smspva_key_here
# TEXTVERIFIED_API_KEY=your_textverified_key_here

# ---------------------------------------------------------------------------
# Qdrant Hybrid Memory (optional — used by qdrant_hybrid_memory.py)
# ---------------------------------------------------------------------------
# QDRANT_URL=localhost:6333
# QDRANT_API_KEY=your_qdrant_key_here
# QDRANT_MEMORY_MODE=false
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# TTL_HOURS=24
# HYBRID_THRESHOLD=0.5
# MEMORY_DIR=./memlogs

# ---------------------------------------------------------------------------
# Encryption (optional — used by reflexion_bot for credential encryption)
# ---------------------------------------------------------------------------
# FERNET_KEY=your_fernet_key_here

# ---------------------------------------------------------------------------
# Bot Behavior (optional — used by reflexion_bot_ultimate_merged.py)
# ---------------------------------------------------------------------------
# MAX_THREADS=1
# HEADLESS_MODE=0
# DEBUG_MODE=0
# USE_GPT=0
# ACCOUNTS_PER_HOUR=2
# FAST_MODE=0
# SCREENSHOT_ON_ERROR=1
# FAST=0
