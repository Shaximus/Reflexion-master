def human_bytes(num: float) -> str:
    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if abs(num) < 1024.0:
            return f"{num:3.1f}{unit}"
        num /= 1024.0
    return f"{num:.1f}PB"


def check_ram_guard(stage: str) -> None:
    """Log RAM usage and warn if approaching limit. Does not kill the run."""
    if psutil is None:
        return
    mem = psutil.virtual_memory()
    used_gb = (mem.total - mem.available) / (1024**3)
    avail_gb = mem.available / (1024**3)
    logger.info(
        f"[RAM] {stage}: used={used_gb:.1f} GB | free={avail_gb:.1f} GB | limit={RAM_LIMIT_GB:.1f} GB"
    )
    if used_gb > RAM_LIMIT_GB * 0.95:
        logger.warning(
            f"[RAM] Approaching or exceeding requested limit ({RAM_LIMIT_GB} GB). Consider reducing NUM_WORKERS or BATCH_SIZE."
        )


def decide_pool_workers(max_workers: int, est_worker_gb: float = 1.2) -> int:
    """
    Choose a safe number of workers based on a rough per-worker memory estimate.
    This doesn't hard-cap memory, but helps stay under the user's 50 GB ceiling.
    """
    if psutil is None:
        return max_workers
    avail_gb = psutil.virtual_memory().available / (1024**3)
    # Leave headroom for arrays and overhead
    budget_gb = max(1.0, min(RAM_LIMIT_GB, avail_gb) * 0.8)
    safe = int(
        max(1, min(max_workers, math.floor(budget_gb / max(0.6, est_worker_gb))))
    )
    if safe < max_workers:
        logger.info(
            f"Reducing pool from {max_workers} -> {safe} workers based on RAM guard"
        )
    return safe


def compact_tweet_text(tweets, max_n=MAX_TWEETS_PER_USER) -> str:
    """
    Build a single text string for HF embeddings from a tweet list.
    Curtis Oct 6: Use ALL tweets (max_n is now effectively unlimited = 999999)
    - If list of dicts: join all texts
    - If list of strings: join all
    - If already a string: return as-is
    """
    if isinstance(tweets, list):
        if not tweets:
            return ""
        if isinstance(tweets[0], dict):
            return " ".join([t.get("text", "") for t in tweets])  # Curtis Oct 6: Removed [-max_n:] limit
        return " ".join(tweets)  # Curtis Oct 6: Removed [-max_n:] limit
    if isinstance(tweets, str):
        return tweets
    return ""


