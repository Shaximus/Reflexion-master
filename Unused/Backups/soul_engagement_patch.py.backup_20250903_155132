class SwarmCoordinator:
    """Coordinate API calls across souls to avoid duplication"""

    def __init__(self):
        self.fetch_cache = {}
        self.cache_ttl = 300  # seconds
        self.fetch_locks = defaultdict(asyncio.Lock)

    async def coordinated_fetch(
        self, tweet_id: str, souls: Dict[str, Any], api_limits: SoulAPILimits
    ):
        """Fetch tweet using the soul with the most available reads"""
        # First, attempt to return from cache if recent
        if tweet_id in self.fetch_cache:
            cache_time, content = self.fetch_cache[tweet_id]
            if time.time() - cache_time < self.cache_ttl:
                return content

        # Identify the best soul to fetch with (most reads available)
        best_soul = None
        max_reads = 0
        for soul_name in souls.keys():
            remaining = 100 - api_limits.soul_usage[soul_name]["reads_used"]
            if remaining > max_reads and api_limits.can_read(soul_name):
                best_soul = soul_name
                max_reads = remaining

        if not best_soul:
            return None

        # Acquire lock per tweet ID to avoid concurrent fetches
        async with self.fetch_locks[tweet_id]:
            # Double-check cache after acquiring the lock
            if tweet_id in self.fetch_cache:
                return self.fetch_cache[tweet_id][1]

            # Fetch the tweet using the selected soul.  Ryan API clients do not
            # provide a `get_tweet` method, so use the async tweet details
            # helper instead.  Each fetch counts as a read for the chosen soul.
            client = souls[best_soul]
            try:
                tweet = await client.get_tweet_details_async(tweet_id)
                api_limits.record_read(best_soul)
            except Exception:
                return None

            # Cache and return
            self.fetch_cache[tweet_id] = (time.time(), tweet)
            return tweet


