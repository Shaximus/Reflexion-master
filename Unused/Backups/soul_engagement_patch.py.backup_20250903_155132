    async def run_autonomous_engagement(self, duration_hours: int = 24):
        """Run autonomous engagement for all souls"""

        logger.info(f"🚀 Starting autonomous engagement for {duration_hours} hours")

        end_time = datetime.now() + timedelta(hours=duration_hours)
        cycle_count = 0

        while datetime.now() < end_time:
            cycle_count += 1
            logger.info(f"\n{'='*60}")
            logger.info(f"📊 ENGAGEMENT CYCLE {cycle_count}")
            logger.info(f"{'='*60}")

            # Run engagement for each soul
            tasks = []
            for soul_name in self.x_clients.keys():
                if random.random() < 0.7:  # 70% chance each soul engages this cycle
                    task = asyncio.create_task(self.run_engagement_cycle(soul_name))
                    tasks.append((soul_name, task))

                    # Stagger soul starts
                    await asyncio.sleep(random.uniform(2, 10))

            # Wait for all engagements to complete
            cycle_stats = defaultdict(lambda: defaultdict(int))
            for soul_name, task in tasks:
                try:
                    stats = await task
                    for engagement_type, count in stats.items():
                        cycle_stats[soul_name][engagement_type] = count
                except Exception as e:
                    logger.error(f"Error in engagement cycle for {soul_name}: {e}")

            # Log cycle summary
            self._log_cycle_summary(cycle_count, cycle_stats)

            # Wait before next cycle
            wait_time = random.uniform(300, 900)  # 5-15 minutes
            logger.info(f"⏰ Next cycle in {wait_time/60:.1f} minutes")
            await asyncio.sleep(wait_time)

        logger.info(f"\n✅ Autonomous engagement complete after {cycle_count} cycles")
        self._log_final_summary()

    def _log_cycle_summary(self, cycle_num: int, stats: Dict[str, Dict[str, int]]):
        """Log summary of engagement cycle"""

        total_engagements = sum(sum(s.values()) for s in stats.values())

        logger.info(f"\nCycle {cycle_num} Summary:")
        logger.info(f"  Total engagements: {total_engagements}")

        for soul_name, soul_stats in stats.items():
            if soul_stats:
                engagements = ", ".join(f"{k}:{v}" for k, v in soul_stats.items())
                logger.info(f"  {soul_name}: {engagements}")

    def _log_final_summary(self):
        """Log final engagement summary"""

        logger.info("\n" + "=" * 60)
        logger.info("📈 FINAL ENGAGEMENT SUMMARY")
        logger.info("=" * 60)

        for soul_name, counts in self.soul_engagement_counts.items():
            total = sum(counts.values())
            logger.info(f"\n{soul_name}: {total} total engagements")
            for engagement_type, count in counts.items():
                logger.info(f"  {engagement_type}: {count}")

        logger.info(
            f"\nTotal engagement history: {len(self.engagement_history)} actions"
        )

    def get_engagement_stats(self) -> Dict[str, Any]:
        """Get current engagement statistics"""

        return {
            "total_engagements": len(self.engagement_history),
            "souls_active": len(self.x_clients),
            "soul_stats": dict(self.soul_engagement_counts),
            "recent_engagements": [
                {
                    "soul": e.soul_name,
                    "type": e.engagement_type.value,
                    "time": e.timestamp.isoformat(),
                }
                for e in list(self.engagement_history)[-10:]
            ],
        }


