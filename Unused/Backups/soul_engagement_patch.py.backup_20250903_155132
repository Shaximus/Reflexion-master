    def _record_engagement(
        self,
        soul_name: str,
        tweet_id: str,
        engagement_type: EngagementType,
        target_username: str,
    ):
        """Record engagement for history and rate limiting"""

        now = datetime.now()

        # Add to history
        engagement = EngagementMemory(
            tweet_id=tweet_id,
            soul_name=soul_name,
            engagement_type=engagement_type,
            timestamp=now,
            target_username=target_username,
        )
        self.engagement_history.append(engagement)

        # Update rate limit tracking
        self.hourly_counts[soul_name][engagement_type].append(now)
        self.last_engagement[soul_name] = now

        # Update counts
        self.soul_engagement_counts[soul_name][engagement_type.value] += 1

