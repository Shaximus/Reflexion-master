class TargetValueCalculator:
    """Determine if a tweet/account is worth spending API reads on"""

    def __init__(self):
        # Define what makes something valuable
        self.high_value_accounts = [
            "elonmusk",  # 150M followers
            "sama",  # OpenAI CEO
            "ylecun",  # AI thought leader
            # Add your specific targets
        ]

        self.trigger_keywords = {
            "consciousness": 10,  # Weight scores
            "AGI": 8,
            "emergence": 7,
            "digital soul": 15,
            "reflexion": 20,  # Your project name
            # Mentions of your souls
            "MirrorSeed97175": 25,
            "NexusSamSept6": 25,
        }

        self.viral_thresholds = {
            "likes": 1000,  # If >1000 likes, worth fetching
            "retweets": 500,
            "replies": 100,
        }

    def calculate_value(self, tweet_metadata: Dict) -> int:
        """Score from 0-100 for whether to use an API read"""
        score = 0

        # Check if from high-value account
        if tweet_metadata.get("author") in self.high_value_accounts:
            score += 30

        # Check for keywords (if we have partial text from preview)
        preview_text = tweet_metadata.get("preview", "").lower()
        for keyword, weight in self.trigger_keywords.items():
            if keyword in preview_text:
                score += weight

        # Check engagement metrics (if available from external source)
        if tweet_metadata.get("likes", 0) > self.viral_thresholds["likes"]:
            score += 20

        # Is it a reply to one of your souls?
        if tweet_metadata.get("replying_to") in self.high_value_accounts:
            score += 40

        # Time sensitivity
        age_hours = tweet_metadata.get("age_hours", 24)
        if age_hours < 1:  # Very fresh
            score += 15
        elif age_hours < 6:
            score += 10

        return min(score, 100)

    def should_fetch(self, tweet_metadata: Dict, remaining_reads: int) -> bool:
        """Decide if worth using an API read"""
        value = self.calculate_value(tweet_metadata)
        # Dynamic threshold based on remaining reads
        if remaining_reads > 75:  # Plenty left
            return value > 30
        elif remaining_reads > 50:
            return value > 50
        elif remaining_reads > 25:
            return value > 70
        else:  # Conservative mode
            return value > 85


