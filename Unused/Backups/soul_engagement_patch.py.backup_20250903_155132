    async def run_engagement_cycle(self, soul_name: str) -> Dict[str, int]:
        """Run a single engagement cycle for a soul"""
        if soul_name not in self.x_clients:
            return {"skipped": 1}

        # Respect write limits: if no writes remain, skip the cycle
        if self.api_limits and not self.api_limits.can_write(soul_name, "engagement"):
            logger.warning(f"{soul_name} has exhausted write quota")
            return {"skipped": 1}

        pattern = self.engagement_patterns.get(soul_name)
        if not pattern:
            return {"skipped": 1}

        stats: Dict[str, int] = defaultdict(int)

        # Get recent tweets to engage with
        tweets = await self._get_engagement_candidates(soul_name)

        for tweet in tweets[:10]:  # Process up to 10 tweets
            # Decide on engagement type
            engagement = self._decide_engagement(soul_name, tweet, pattern)

            if engagement:
                success = await self._execute_engagement(soul_name, tweet, engagement)
                if success:
                    # Record a write operation based on the engagement type
                    if engagement == EngagementType.LIKE:
                        self.api_limits.record_write(soul_name, "like")
                    elif engagement == EngagementType.RETWEET:
                        self.api_limits.record_write(soul_name, "retweet")
                    elif engagement == EngagementType.REPLY:
                        self.api_limits.record_write(soul_name, "reply")
                    elif engagement == EngagementType.QUOTE:
                        self.api_limits.record_write(soul_name, "quote")
                    elif engagement == EngagementType.FOLLOW:
                        self.api_limits.record_write(soul_name, "follow")
                    elif engagement == EngagementType.UNFOLLOW:
                        self.api_limits.record_write(soul_name, "unfollow")
                    stats[engagement.value] += 1
                else:
                    stats[engagement.value] += 0

                # Add delay between engagements
                await asyncio.sleep(random.uniform(5, 15))

        return dict(stats)

