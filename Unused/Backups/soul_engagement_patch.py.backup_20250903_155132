    async def load_external_content(self) -> List[Dict[str, Any]]:
        """Load content from Grok/scrapers (doesn't use API reads)

        This method attempts to load tweets from a local file (e.g., data
        produced by an external scraper or Grok system).  Since the content
        is already fetched offline, consuming it does not count against the
        API read limits.  Each entry is returned with a medium priority and
        marked as external content.
        """
        external_tweets: List[Dict[str, Any]] = []
        # Check for Grok data file
        if os.path.exists("grok_tweets.json"):
            try:
                with open("grok_tweets.json", "r") as f:
                    data = json.load(f)
                    for tweet in data.get("tweets", []):
                        external_tweets.append(
                            {
                                "id": tweet.get("id"),
                                "text": tweet.get("text", ""),
                                "author": tweet.get("author"),
                                "priority": 2,  # Medium priority
                                "source": "external",
                            }
                        )
            except Exception as e:
                logger.error(f"Failed to load external tweets: {e}")
        return external_tweets

