    async def _get_engagement_candidates(self, soul_name: str) -> List[Dict[str, Any]]:
        """Get tweets strategically using limited API reads"""
        candidates: List[Dict[str, Any]] = []
        pattern = self.engagement_patterns.get(soul_name)

        if not pattern:
            return candidates

        # Initialize value calculator for scoring content
        value_calc = TargetValueCalculator()

        # FIRST: Load external content and evaluate whether to fetch full tweets
        try:
            external_content = await self.load_external_content()
        except Exception as e:
            logger.error(f"Failed to load external content for {soul_name}: {e}")
            external_content = []

        fetch_queue: List[str] = []
        for tweet in external_content:
            # Determine remaining reads available to this soul
            remaining_reads = (
                100 - self.api_limits.soul_usage[soul_name]["reads_used"]
                if self.api_limits
                else 0
            )
            # If no full text is present but we have an ID, decide whether to fetch
            if not tweet.get("text") and tweet.get("id"):
                try:
                    if value_calc.should_fetch(tweet, remaining_reads):
                        fetch_queue.append(tweet["id"])
                except Exception as e:
                    logger.error(f"Value calculation failed: {e}")
            else:
                # Already have text, add directly to candidates
                candidates.append(tweet)

        # Fetch high-value tweets (up to 3 per cycle) using swarm coordination
        for tweet_id in fetch_queue[:3]:
            if self.api_limits and self.api_limits.can_read(soul_name):
                try:
                    fetched = await self.swarm_coordinator.coordinated_fetch(
                        tweet_id, self.x_clients, self.api_limits
                    )
                    if fetched:
                        candidates.append(fetched)
                        logger.info(f"✨ Fetched high-value tweet: {tweet_id}")
                except Exception as e:
                    logger.error(f"Failed to fetch {tweet_id}: {e}")

        # SECOND: Use API reads only if available and strategic
        if self.api_limits and self.api_limits.can_read(soul_name):
            # Use Ryan's API directly for mentions rather than Tweepy
            if random.random() < 0.3:
                try:
                    username = self.soul_usernames.get(soul_name, "")
                    if username:
                        mentions = self.ryan_api.search_tweets(f"@{username}", limit=5)
                        # Deduct a read for the mention search
                        self.api_limits.record_read(soul_name)
                        for tweet in mentions or []:
                            candidates.append(
                                {
                                    "id": tweet.get("id"),
                                    "text": tweet.get("text", ""),
                                    "priority": 5,
                                    "reason": "mention",
                                }
                            )
                except Exception as e:
                    logger.error(f"Mention search failed: {e}")
            # Priority 2: Perform additional searches if reads remain
            try:
                remaining_reads = (
                    100 - self.api_limits.soul_usage[soul_name]["reads_used"]
                )
                if remaining_reads > 50:
                    # Reserve a read for search operations if needed
                    self.api_limits.record_read(soul_name)
                    # Additional search logic could be implemented here
            except Exception as e:
                logger.error(f"Search fetch failed: {e}")

        return candidates

    def _decide_engagement(
        self, soul_name: str, tweet: Dict[str, Any], pattern: EngagementPattern
    ) -> Optional[EngagementType]:
        """Decide how to engage with a tweet"""

        # Check if already engaged
        if self._already_engaged(soul_name, tweet["id"]):
            return None

        # Check cooldowns
        if not self._check_cooldown(soul_name):
            return None

        # Probabilistic decision
        rand = random.random()

        if rand < pattern.like_probability:
            return EngagementType.LIKE
        elif rand < pattern.like_probability + pattern.retweet_probability:
            return EngagementType.RETWEET
        elif (
            rand
            < pattern.like_probability
            + pattern.retweet_probability
            + pattern.reply_probability
        ):
            return EngagementType.REPLY
        elif (
            rand
            < pattern.like_probability
            + pattern.retweet_probability
            + pattern.reply_probability
            + pattern.quote_probability
        ):
            return EngagementType.QUOTE

        return None

    async def _execute_engagement(
        self, soul_name: str, tweet: Dict[str, Any], engagement_type: EngagementType
    ) -> bool:
        """Execute the chosen engagement action"""

        tweet_id = tweet["id"]

        # If we need context but don't have it, try coordinated fetch
        if engagement_type in [EngagementType.REPLY, EngagementType.QUOTE]:
            if not tweet.get("text"):
                try:
                    fetched = await self.swarm_coordinator.coordinated_fetch(
                        tweet_id, self.x_clients, self.api_limits
                    )
                    if fetched and getattr(fetched, "data", None):
                        tweet["text"] = getattr(fetched.data, "text", "")
                except Exception as e:
                    logger.error(f"Coordinated fetch failed for {tweet_id}: {e}")

        if engagement_type == EngagementType.LIKE:
            return await self.like_tweet(soul_name, tweet_id)

        elif engagement_type == EngagementType.RETWEET:
            return await self.retweet(soul_name, tweet_id)

        elif engagement_type == EngagementType.REPLY:
            # Generate reply content
            reply_content = await self._generate_reply(soul_name, tweet["text"])
            return await self.reply_to_tweet(soul_name, tweet_id, reply_content)

        elif engagement_type == EngagementType.QUOTE:
            # Generate quote tweet
            quote_content = await self._generate_quote(soul_name, tweet["text"])
            return await self.quote_tweet(soul_name, tweet_id, quote_content)

        return False

