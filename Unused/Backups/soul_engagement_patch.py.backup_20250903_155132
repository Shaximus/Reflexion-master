    """Apply engagement capabilities to a hybrid souls orchestrator.

    This function augments the provided orchestrator with engagement
    functionality (liking, retweeting, replies, quotes and inter-soul
    engagement). To avoid multiple applications of the patch, a flag
    ``_engagement_patch_applied`` is set on the orchestrator after
    successful application. Subsequent calls will return the existing
    patch instance without reapplying.

    Parameters
    ----------
    hybrid_orchestrator : Any
        The orchestrator instance to augment.
    memory_patch : Optional[Any]
        Optional memory patch to pass through to the engagement system.

    Returns
    -------
    HybridEngagementPatch
        The engagement patch instance used to extend the orchestrator.
    """
    # If the patch has already been applied, return existing patch
    if getattr(hybrid_orchestrator, "_engagement_patch_applied", False):
        logger.info("⚠️ Engagement patch already applied; skipping reapplication")
        return getattr(hybrid_orchestrator, "engagement_patch", None)

