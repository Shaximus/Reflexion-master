    def _check_rate_limit(
        self, soul_name: str, engagement_type: EngagementType
    ) -> bool:
        """Check if soul is within rate limits"""
        pattern = self.engagement_patterns.get(soul_name)
        if not pattern:
            return False

        now = datetime.now()
        hour_ago = now - timedelta(hours=1)

        # Clean old entries
        soul_history = self.hourly_counts[soul_name][engagement_type]
        while soul_history and soul_history[0] < hour_ago:
            soul_history.popleft()

        # Check limits
        if engagement_type == EngagementType.LIKE:
            if len(soul_history) >= pattern.max_likes_per_hour:
                return False
        elif engagement_type == EngagementType.RETWEET:
            if len(soul_history) >= pattern.max_retweets_per_hour:
                return False
        elif engagement_type == EngagementType.REPLY:
            if len(soul_history) >= pattern.max_replies_per_hour:
                return False

        return True

    def _check_cooldown(self, soul_name: str) -> bool:
        """Check if soul has waited long enough since last engagement"""
        pattern = self.engagement_patterns.get(soul_name)
        if not pattern:
            return False

        if soul_name in self.last_engagement:
            time_since = (
                datetime.now() - self.last_engagement[soul_name]
            ).total_seconds()
            if time_since < pattern.min_engagement_interval:
                return False

        return True

    def _already_engaged(self, soul_name: str, tweet_id: str) -> bool:
        """Check if soul already engaged with this tweet"""
        for engagement in self.engagement_history:
            if engagement.soul_name == soul_name and engagement.tweet_id == tweet_id:
                return True
        return False

