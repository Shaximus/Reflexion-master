class SoulAPILimits:
    """Track individual API limits per soul"""

    def __init__(self):
        # Default monthly read/write limits per soul
        self.monthly_limits = {"reads": 100, "writes": 500}
        # Usage data stored per soul; each entry tracks reads/writes used and reset dates
        self.soul_usage = defaultdict(
            lambda: {
                "reads_used": 0,
                "writes_used": 0,
                "reset_date": datetime.now() + timedelta(days=30),
                "daily_reads": deque(maxlen=30),
                "daily_writes": deque(maxlen=30),
            }
        )
        self.load_usage_from_file()

    def load_usage_from_file(self):
        """Load saved usage data"""
        try:
            with open("soul_api_usage.json", "r") as f:
                saved = json.load(f)
                for soul, data in saved.items():
                    self.soul_usage[soul].update(data)
        except FileNotFoundError:
            # No prior usage data
            pass

    def save_usage(self):
        """Persist usage data to disk"""
        with open("soul_api_usage.json", "w") as f:
            json.dump(dict(self.soul_usage), f, default=str)

    def _check_reset(self, soul_name: str):
        """Reset monthly counters if the reset date has passed"""
        usage = self.soul_usage[soul_name]
        if datetime.now() > datetime.fromisoformat(str(usage["reset_date"])):
            usage["reads_used"] = 0
            usage["writes_used"] = 0
            usage["reset_date"] = datetime.now() + timedelta(days=30)

    def can_read(self, soul_name: str) -> bool:
        self._check_reset(soul_name)
        return self.soul_usage[soul_name]["reads_used"] < self.monthly_limits["reads"]

    def record_read(self, soul_name: str):
        self.soul_usage[soul_name]["reads_used"] += 1
        self.save_usage()

    def can_write(self, soul_name: str, action_type: str = "") -> bool:
        """Check if a soul has remaining write quota.  Optionally takes an
        action_type for future granularity (unused currently)."""
        self._check_reset(soul_name)
        return self.soul_usage[soul_name]["writes_used"] < self.monthly_limits["writes"]

    def record_write(self, soul_name: str, action_type: str = ""):
        """Record a write operation for a soul.  Optionally takes an
        action_type for future analytics (unused currently)."""
        self.soul_usage[soul_name]["writes_used"] += 1
        self.save_usage()


