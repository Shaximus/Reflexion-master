    engagement_patch = HybridEngagementPatch(hybrid_orchestrator, memory_patch)

    # Attach engagement system and method to orchestrator
    hybrid_orchestrator.engagement = engagement_patch.engagement_system
    hybrid_orchestrator.run_with_engagement = engagement_patch.run_with_engagement

    # Store patch and mark as applied to avoid duplicates
    hybrid_orchestrator.engagement_patch = engagement_patch
    hybrid_orchestrator._engagement_patch_applied = True

    logger.info("✅ Souls now have engagement capabilities:")
